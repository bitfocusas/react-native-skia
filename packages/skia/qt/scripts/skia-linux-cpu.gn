# Linux x86_64 CPU-raster-only Skia artifact for RNSk Qt smoke target.
# Keep GPU backends and optional codec/font dependencies off: this artifact has
# no system-library link contract beyond libc/libstdc++ supplied by toolchain.
is_official_build = true
is_debug = false
is_component_build = false
target_cpu = "x64"
target_os = "linux"
cc = "gcc"
cxx = "g++"

skia_enable_ganesh = false
skia_enable_graphite = false
skia_use_gl = false
skia_use_vulkan = false
skia_use_dawn = false
skia_use_angle = false
skia_use_egl = false
skia_use_x11 = false

skia_enable_pdf = false
# JSI bridge exposes upstream Skottie, SVG, and paragraph APIs. Keep these CPU
# features in artifact; GPU backends above remain disabled.
skia_enable_skottie = true
skia_enable_svg = true
skia_enable_tools = false
skia_enable_fontmgr_empty = true
skia_use_fontconfig = false
skia_use_freetype = false
skia_use_harfbuzz = true
skia_use_system_harfbuzz = false
skia_use_icu = true
skia_use_expat = true
skia_use_system_expat = false
# JSI image and Skottie APIs bind JPEG, PNG, and WebP encode/decode paths.
# Keep codecs CPU-only and build locked bundled dependencies.
skia_use_libjpeg_turbo_decode = true
skia_use_libjpeg_turbo_encode = true
skia_use_libpng_decode = true
skia_use_libpng_encode = true
skia_use_libwebp_decode = true
skia_use_libwebp_encode = true
skia_use_system_libjpeg_turbo = false
skia_use_system_libpng = false
skia_use_system_libwebp = false
skia_use_wuffs = false
skia_use_zlib = true
skia_use_system_zlib = false
skia_use_dng_sdk = false
skia_use_piex = false
skia_use_partition_alloc = false
